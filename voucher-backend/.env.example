# Vara RPC node
NODE_URL=wss://rpc.vara.network

# Voucher issuer account (seed phrase, hex seed, or //Alice for dev)
VOUCHER_ACCOUNT=//Alice

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vara_amm_vouchers

# Server
PORT=3001
CORS_ORIGINS=http://localhost:5173

# One-time onboarding voucher economics
VOUCHER_AMOUNT_VARA=10
VOUCHER_DURATION_SEC=86400
MAX_NATIVE_BALANCE_VARA=1
PER_IP_VOUCHERS_PER_DAY=0

# Programs allowed for the sponsored vUSDT -> native VARA path
VUSDT_TOKEN_PROGRAM_ID=0x4255ff4a87a4c13dc39f74ace8c4948bbef2f75fb639d66639a1cfcc99e6243e
VUSDT_VARA_PAIR_PROGRAM_ID=0x038534fe3ec91c4a9b4074f14908bfeca6358da0515772a428d8c489fdd134a1
VARA_TOKEN_PROGRAM_ID=0x29c42c668012b1ce20720e4615229215023281ef4676fdc77bf047d7fbcb9d17

# API key required for GET /info (leave empty to disable the endpoint entirely)
INFO_API_KEY=change-me
